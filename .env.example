# ===========================================
# DOCKER НАСТРОЙКИ
# ===========================================
DOCKER_HOST_USER=www-data
DOCKER_HOST_UID=1000
DOCKER_HOST_GROUP=www-data
DOCKER_HOST_GID=1000

# Порты
DOCKER_PORT_HTTP=80
DOCKER_PORT_HTTPS=443
DOCKER_PORT_DB=3306
DOCKER_PORT_REDIS=6379
DOCKER_PORT_MAILPIT_WEB=8025
DOCKER_PORT_MAILPIT_SMTP=1025
DOCKER_PORT_PHPMYADMIN=8081
FRONTEND_PORT=3000

# ===========================================
# ОБЩИЕ НАСТРОЙКИ БД И СЕРВИСОВ
# ===========================================
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=secret

# ===========================================
# LARAVEL BACKEND НАСТРОЙКИ
# ===========================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# База данных (используем имена Docker сервисов)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis (используем имя Docker сервиса)
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Почта (используем имя Docker сервиса)
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# CORS и Sanctum настройки
FRONTEND_URL=http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Дополнительные сервисы
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Переменные для Vite (Laravel)
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"